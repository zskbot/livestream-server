# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=5000

# Database connection
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=livestream
DB_USER=YOUR_DB_USER
DB_PASS=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Authentication
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
